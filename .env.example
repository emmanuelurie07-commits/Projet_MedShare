# Copie vers `.env` puis adaptation (`.env` n'est jamais versionne).
SECRET_KEY=change-me-une-longue-chaine-aleatoire
DEBUG=False
ALLOWED_HOSTS=*          # Ou votre domaine : medshare.example.com,...

# ---- Base de données -----------------------------------------------
# Moteur : sqlite (dev) | postgresql (prod/docker) | mysql (PythonAnywhere)
# Si DB_ENGINE est vide : sqlite si DEBUG=True, sinon postgresql.
DB_ENGINE=postgresql
DB_NAME=medshare
DB_USER=medshare
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ---- PostgreSQL (utilise par docker-compose pour le service db ET web)
POSTGRES_DB=medshare
POSTGRES_USER=medshare
POSTGRES_PASSWORD=change-me

# ---- Emails --------------------------------------------------------
# Renseignez ces variables pour un VRAI envoi (SMTP). Si elles sont vides,
# le backend console est utilise (e-mails affiches dans le terminal).
# Exemples :
#   Gmail : EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True
#           (mot de passe d'application, pas le mot de passe du compte)
#   Mailtrap : EMAIL_HOST=smtp.mailtrap.io, EMAIL_PORT=587, EMAIL_USE_TLS=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=medshare@example.com
# EMAIL_HOST_PASSWORD=change-me
# DEFAULT_FROM_EMAIL=MedShare <no-reply@medshare.com>

# ---- Super Admin (migration 0008) ------------------------------------
# Mot de passe INITIAL (provisoire) du compte Super Admin créé par la
# migration 0008. Laissez VIDE : une valeur forte aléatoire est générée.
# Un changement de mot de passe est de toute façon imposé à la 1re connexion.
# SUPERADMIN_INITIAL_PASSWORD=change-me