{
  "name": "medshare-tailwind",
  "version": "1.0.0",
  "private": true,
  "description": "Build Tailwind CSS pour MedShare",
  "scripts": {
    "build:css": "tailwindcss -i ./input.css -o ./static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./input.css -o ./static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.16"
  }
}