@startuml cas_util_candidature
' Cas d'utilisation détaillé — candidature & création d'établissement/personnel
left to right direction
skinparam actorStyle awesome

actor "Candidat" as C

rectangle "Sous-système Candidature" {
  usecase "Soumettre une candidature" as A1
  usecase "Renseigner ses informations" as A2
  usecase "Choisir l'établissement et le rôle" as A3
  usecase "Recevoir une confirmation" as A4
  usecase "Suivre le statut par e-mail" as A5

  usecase "Gérer les candidatures" as B1
  usecase "Examiner le dossier" as B2
  usecase "Accepter la candidature" as B3
  usecase "Refuser (avec motif)" as B4
  usecase "Activer le compte du personnel" as B5
  usecase "Générer un mot de passe temporaire" as B6
}

C --> A1
A1 <.. A2 : <<include>>
A1 <.. A3 : <<include>>
A1 --> A4 : <<include>>
C --> A5

actor "Administrateur" as D
D --> B1
B1 <.. B2 : <<include>>
B1 <.. B3 : <<extend>>
B1 <.. B4 : <<extend>>
B3 <.. B5 : <<include>>
B5 <.. B6 : <<include>>

note right of B5
  Le candidat n'a PAS de compte MedShare.
  À l'acceptation : création du compte Personnel,
  mot de passe temporaire + changement obligatoire
  au premier accès.
end note

@enduml