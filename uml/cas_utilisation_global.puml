@startuml cas_utilisation_global
' Diagramme de cas d'utilisation global — MedShare
left to right direction
skinparam actorStyle awesome

actor "Candidat" as Candidat
actor "Administrateur" as AdminGest
actor "Infirmier" as Infirmier
actor "Médecin" as Medecin
actor "Administrateur d'établissement" as AdminEtab
actor "Super administrateur" as SuperAdmin

rectangle "MedShare — Plateforme" {
  usecase "Soumettre une candidature" as UC1
  usecase "Suivre sa candidature" as UC2
  usecase "S'authentifier" as UC3
  usecase "Changer son mot de passe" as UC4
  usecase "Gérer les candidatures" as UC5
  usecase "Activer le compte du candidat accepté" as UC6
  usecase "Rechercher / créer un patient" as UC7
  usecase "Consulter le DMP" as UC8
  usecase "Documenter une consultation" as UC9
  usecase "Prescrire un traitement" as UC10
  usecase "Créer un DUT (urgence)" as UC11
  usecase "Réaliser le triage (priorité)" as UC12
  usecase "Relever les constantes" as UC13
  usecase "Rechercher l'identité (faciale)" as UC14
  usecase "Confirmer l'identité et fusionner DUT → DMP" as UC15
  usecase "Clôturer le DUT" as UC16
  usecase "Gérer l'établissement" as UC17
  usecase "Gérer l'abonnement SaaS" as UC18
  usecase "Gérer les établissements (plateforme)" as UC19
}

Candidat --> UC1
Candidat --> UC2
AdminGest --> UC5
AdminGest --> UC6
Infirmier --> UC3
Infirmier --> UC4
Médecin --> UC3
Médecin --> UC4
AdminEtab --> UC3
AdminEtab --> UC4
SuperAdmin --> UC3

Infirmier --> UC7
Infirmier --> UC8
Médecin --> UC8
Médecin --> UC9
Médecin --> UC10
Infirmier --> UC11
Infirmier --> UC12
Infirmier --> UC13
Infirmier --> UC14
Infirmier --> UC15
Infirmier --> UC16

AdminEtab --> UC17
AdminEtab --> UC18
SuperAdmin --> UC19

UC8 <.. UC9 : <<include>> (une consultation enrichit le DMP)
UC15 <.. UC14 : <<include>> (la fusion suit la confirmation d'identité)
UC6 <.. UC5 : <<extend>> (décision d'acceptation déclenche l'activation)

@enduml