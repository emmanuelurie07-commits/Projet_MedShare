@startuml sequence_urgence_faciale
' Diagramme de séquence — Urgence : DUT, triage, constante, reconnaissance faciale, fusion
actor "Infirmier" as I
participant "Interface MedShare" as UI
participant "DUT" as Dut
participant "Triage" as T
participant "Constante" as Ct
participant "Service Faciale" as Sf
participant "RechercheIdentite" as Ri
participant "DMP" as Dmp

I -> UI : patient anonyme à l'urgence
UI -> Dut : créer(numeroDUT, infos)
Dut --> UI : DUT créé (ACTIF)

I -> UI : réaliser triage(priorité)
UI -> T : créer(triage)
T -> Dut : triage unique
T --> UI : priorité définie

loop mesures
  I -> UI : relever constantes
  UI -> Ct : créer(constantes)
  Ct --> UI : constantes enregistrées
end

I -> UI : lancer recherche identité (photo)
UI -> Sf : POST /api/match (photo)
Sf --> UI : correspondances + confiance
UI -> Ri : créer(recherche, statut=EN_RECHERCHE)
Ri --> UI : liste des patients probables
UI --> I : correspondances affichées

I -> UI : confirmer l'identité (patient trouvé)
UI -> Ri : confirmer(patientCorrespondant, confiance)
Ri --> UI : statut CONFIRMEE

UI -> Dut : fusionner_avec_dmp(dmp)
Dut -> Dmp : rattache DMP
Dut --> UI : statut FUSIONNE, identiteConfirmee=True

I -> UI : clôturer le DUT
UI -> Dut : cloturer()
Dut --> UI : statut INACTIF, dateCloture

@enduml